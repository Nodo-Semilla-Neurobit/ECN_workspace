	color: var(--text-dim);
	font-size: 0.77rem;
	line-height: 1.35;
}

.mfn-console {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	gap: 8px;
	min-height: 0;
}

.controls-panel,
.library-panel,
.compression-panel {
<!--	padding: 8px;-->
}

.controls-panel label {
	display: grid;
	grid-template-columns: auto minmax(54px, 1fr);
	align-items: center;
	gap: 5px;
}

select,
button {
	box-sizing: border-box;
	min-height: 36px;
	border: 1px solid rgba(198, 255, 211, 0.26);
