.mfn-shell {
	--panel: rgba(8, 18, 20, 0.78);
	--panel-strong: rgba(15, 31, 34, 0.92);
	--line: rgba(102, 255, 123, 0.45);
	--text-dim: #a9c4c1;
	box-sizing: border-box;
	position: relative;
	width: 100%;
	height: 100%;
	min-width: 0;
	min-height: 0;
	overflow: hidden;
	background:
		linear-gradient(180deg, rgba(2, 8, 9, 0.4), rgba(2, 9, 10, 0.84)),
		var(--mfn-dash-texture),
		radial-gradient(circle at 30% 15%, rgba(30, 255, 199, 0.16), transparent 34%),
		#071011;
	background-size: cover;
	background-position: center;
}

.mfn-workbench {
	box-sizing: border-box;
	display: grid;
	grid-template-rows: auto minmax(0, 1fr) auto auto;
	gap: 8px;
	width: 100%;
	height: 100%;
	min-width: 0;
	min-height: 0;
<!--	padding: 8px;-->
}

.mfn-hud {
	display: grid;
	grid-template-columns: 1fr 1.35fr 1fr;
	gap: 7px;
	min-width: 0;
}

.hud-chip,
.panel,
.transmission-panel {
	box-sizing: border-box;
	border: 1px solid var(--line);
	background: var(--panel);
	box-shadow: inset 0 0 18px rgba(89, 255, 123, 0.06), 0 0 18px rgba(0, 0, 0, 0.28);
	backdrop-filter: blur(8px);
}

.hud-chip {
	display: grid;
	align-content: center;
	gap: 1px;
	min-width: 0;
	<!--padding: 7px 9px;-->
	border-radius: 10px;
}

.hud-chip span,
.panel-title,
.inspector-row,
.transmission-panel span,
.controls-panel label {
	color: var(--text-dim);
	font-family: "Space Mono", ui-monospace, monospace;
	font-size: clamp(0.64rem, 1.6vw, 0.78rem);
	letter-spacing: 0.02em;
	text-transform: uppercase;
}

.hud-chip strong {
	overflow: hidden;
	color: #f4fff9;
	font-family: "Space Mono", ui-monospace, monospace;
	font-size: clamp(0.86rem, 2.6vw, 1.1rem);
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.hud-chip.primary strong {
	color: #69ff87;
}

.mfn-main {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	grid-template-rows: minmax(180px, 1.1fr) minmax(180px, 1fr) auto;
	gap: 8px;
	min-width: 0;
	min-height: 0;
}

.panel {
	min-width: 0;
	min-height: 0;
	border-radius: 13px;
}

.canvas-panel {
	display: grid;
	grid-template-rows: auto minmax(0, 1fr);
<!--	padding: 7px;-->
}

.panel-title {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
<!--	padding: 0 2px 6px;-->
}

.panel-title b,
.inspector-row b {
	color: #eefbf4;
	font-weight: 700;
}

.mfn-canvas {
	border-radius: 9px;
	background: rgba(3, 10, 12, 0.62);
}

.inspector-panel {
	display: grid;
	grid-template-columns: 1fr;
	gap: 6px;
<!--	padding: 8px;-->
}

.inspector-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
}

.bitstream {
	box-sizing: border-box;
	min-height: 74px;
	max-height: 110px;
<!--	margin: 0;-->
	overflow: auto;
