	border: 1px solid rgba(91, 247, 116, 0.22);
	border-radius: 8px;
	background: rgba(0, 0, 0, 0.35);
	color: #c8feda;
	font-family: "Space Mono", ui-monospace, monospace;
	font-size: 0.72rem;
	line-height: 1.22;
}

.mode-tabs,
.controls-panel,
.library-grid {
	display: flex;
	gap: 6px;
	flex-wrap: wrap;
}

.mode-note {
	min-height: 2.2em;
