		for (let col = 0; col <= 13 - size; col += 1) {
			const key = blockKey(matrix, row, col, size);
			if (!table.has(key)) {
				table.set(key, { id: `P${table.size.toString().padStart(2, "0")}`, key, size, coordinates: [] });
