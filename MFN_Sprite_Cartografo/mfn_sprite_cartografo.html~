		header: "MFN_COMPRESSED_V1",
		blockSize,
		rawBits: TOTAL_BITS,
		estimatedBits,
		ratio: TOTAL_BITS / estimatedBits,
		activeBits: activeCount(clean),
		patterns,
		repeatedPatterns: repeated.slice(0, 16),
