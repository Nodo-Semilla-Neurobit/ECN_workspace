		header: "MFN_SPRITE_V1",
		total_bits: TOTAL_BITS,
		baud: 300,
		active_bits: activeCount(clean),
		patterns_count: compression.repeatedPatterns.length,
		estimated_bits: compression.estimatedBits,
		hex,
	};
